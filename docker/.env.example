# AI 服务配置
# 可选值：openai、openrouter
export LLM_PROVIDER=openai

export OPENAI_API_KEY=sk-proj-your-openai-api-key
export OPENAI_BASE_URL=https://api.openai.com/v1
export OPENAI_MODEL=gpt-4o-mini

export OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
export OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
export OPENROUTER_MODEL=openai/gpt-4o-mini

export DEEPSEEK_API_KEY=sk-your-deepseek-api-key
export DEEPSEEK_MODEL=deepseek-chat

export CLAUDE_API_KEY=sk-ant-api03-your-claude-api-key
export CLAUDE_MODEL=claude-3-7-sonnet-20250219

# Tavily API Key，通常以 tvly- 开头
export TAVILY_API_KEY="tvly-xxx"
# 可选：覆盖默认的 Tavily MCP Server 基础地址
# export MCP_TAVILY_BASE_URL="https://mcp.tavily.com/mcp/"

# 后端 API 基础地址
export API_BASE_URL=http://127.0.0.1:8080/api
